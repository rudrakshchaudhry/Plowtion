# Copy to .env.local. Every value is optional; the app builds and runs without them.

# Flask API base URL used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:5001

# Google sign-in (Auth.js). Leave empty to run without authentication.
# AUTH_SECRET can be generated with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Optional: persist signed-in users with the Auth.js MongoDB adapter.
MONGODB_URI=
