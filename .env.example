# Copy to .env (backend / docker compose) and fill in only what you need.
# Nothing here is required for local development: the backend uses the bundled
# model, keyless Open-Meteo weather, and runs without a database.

# --- Backend ---------------------------------------------------------------
# MongoDB connection string. Leave empty to disable storage endpoints.
# Local example: mongodb://localhost:27017/farmnest
MONGO_URI=
MONGO_DB_NAME=farmnest
# Comma-separated list of allowed browser origins ("*" = any).
CORS_ORIGINS=http://localhost:3000
# Optional chatbot: any OpenAI-compatible chat completions API (default: Perplexity).
LLM_API_KEY=
LLM_BASE_URL=https://api.perplexity.ai
LLM_MODEL=sonar
# Optional remote inference. Leave empty to use the local model (requires boto3 and AWS credentials).
SAGEMAKER_ENDPOINT=
AWS_DEFAULT_REGION=us-east-1

# --- Frontend (docker compose) ----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5001
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
